TELEGRAM_BOT_TOKEN=
COMPANY_NAME=Star Media Group
HR_CONTACT_EMAIL=hr@example.com

# Optional - omit any of these and the bot falls back automatically:
# no OPENAI_API_KEY -> answers are verbatim retrieved clauses, not LLM-generated.
# no SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY -> retrieval uses local sample_docs.py
# (keyword search) instead of the documents uploaded via the admin dashboard,
# and questions aren't logged for the analytics view.
OPENAI_API_KEY=
# gpt-4o-mini: $0.15/$0.60 per 1M input/output tokens - cheap, reliable,
# well-documented. Good fit for synthesizing an answer from a few retrieved
# policy clauses. Override if you want a different model.
OPENAI_MODEL=gpt-4o-mini
SUPABASE_URL=
# Use the "Secret" key from Supabase's new Publishable/Secret key system
# (Project Settings > API Keys), not the legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=
